# Copy to deploy/gcp.env and fill in. deploy/gcp.env holds passwords: never share or commit it.

# Google Cloud project ID (Console > project picker; looks like tender-india-123456)
GCP_PROJECT=

# Mumbai: close to the government portals and to you. Use the same region for Supabase (ap-south-1).
GCP_REGION=asia-south1

# Supabase > Project > Connect > "Session pooler" connection string (port 5432), with your
# database password filled in. Example:
# postgresql://postgres.abcdefghijklmnop:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# If the password has @ : / # ? or % in it, URL-encode them (or pick a password without them).
DATABASE_URL=

# Password for the website (browser asks for it once). Required: without it anyone on the
# internet could press Delete and Refresh.
SITE_USER=admin
SITE_PASSWORD=

# Secret the website uses to call delete/refresh on the API. Leave empty: one is generated.
ADMIN_TOKEN=

# Automatic refresh (cron, Indian time). Twice a week keeps the Supabase free project awake
# (it pauses after 7 quiet days) and stays inside the free Cloud Run allowance.
# Daily: "30 6 * * *". Empty = only the Refresh button.
AUTO_REFRESH_CRON="30 6 * * 1,4"

# Longest one refresh may run before Cloud Run stops it.
SCRAPER_TIMEOUT=6h
