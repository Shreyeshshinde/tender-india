# Copy this file to .env (same folder) and adjust.

# PostgreSQL (recommended). Matches docker-compose.yml in the project root.
DATABASE_URL=postgresql+psycopg://tender:tender@localhost:5432/tenders

# Or keep using the SQLite file (no install needed):
# DATABASE_URL=sqlite:///tenders.db

# Or Supabase (Connect > Session pooler, port 5432):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Website address allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Refresh button: local (start scrapers on this PC) | none (a PC running app.schedule --listen) | cloudrun
# REFRESH_RUNNER=local
# Protect delete / restore / refresh (set the same value for the website)
# ADMIN_TOKEN=
